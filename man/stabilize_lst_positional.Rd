\description{
\code{stabilize_lst_positional()} validates a list as a tuple: the \emph{i}th spec in
\code{...} is applied to the \emph{i}th element of \code{.x}. Elements after the last spec
are controlled by \code{.additional}. This mirrors JSON Schema's \code{prefixItems}
(with \code{.additional} playing the role of \code{items}). Failures at every position
are collected and reported together. \code{stabilise_lst_positional()},
\code{stabilize_list_positional()}, \code{stabilise_list_positional()},
\code{stabilize_tuple()}, and \code{stabilise_tuple()} are synonyms.
}
\examples{
# [lon, lat]
stabilize_lst_positional(
  list(-122.4, 37.8),
  stabilize_dbl_scalar,
  stabilize_dbl_scalar
)

# An address tuple: [number, street, street type, direction]
stabilize_lst_positional(
  list(1600, "Pennsylvania", "Avenue", "NW"),
  specify_dbl_scalar(),
  specify_chr_scalar(),
  specify_chr_scalar(allowed_values = c("Street", "Avenue", "Boulevard")),
  specify_chr_scalar(allowed_values = c("NW", "NE", "SW", "SE"))
)

# Trailing positions can be optional
stabilize_lst_positional(
  list(1600, "Pennsylvania"),
  specify_dbl_scalar(),
  specify_chr_scalar(),
  specify_chr_scalar(),
  .n_required = 2
)

# Allow and validate extra elements
stabilize_lst_positional(
  list("a", 1L, 2L, 3L),
  stabilize_chr_scalar,
  .additional = stabilize_int_scalar
)

# Simplify to an atomic vector when possible
stabilize_lst_positional(
  list(1.5, 2L),
  stabilize_dbl_scalar,
  stabilize_int_scalar,
  .simplify = TRUE
)

# Every failing position is reported
try(
  stabilize_lst_positional(
    list("a", "b", "c"),
    stabilize_chr_scalar,
    stabilize_int_scalar,
    stabilize_lgl_scalar
  )
)
}
